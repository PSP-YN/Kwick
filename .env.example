# NexHelp Environment Configuration Template
# Copy this file to .env for local development

# ==========================================
# Supabase Configuration
# ==========================================
# For local development with Supabase CLI:
# Default local URL: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_local_development

# Service Role Key (NEVER expose to Flutter client or browser)
# Used only by local testing scripts or server edge workers
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Next.js Admin Dashboard Configuration
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_local_development

# ==========================================
# Firebase Cloud Messaging (Production)
# ==========================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
